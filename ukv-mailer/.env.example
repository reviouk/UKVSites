# ---- Database (Render Postgres: use the Internal URL on the web service, External URL from your PC) ----
DATABASE_URL=postgres://user:pass@host:5432/ukv_mailer

# ---- Public base URL of this service (used in tracking + unsubscribe links) ----
BASE_URL=https://ukv-mailer.onrender.com
# Brand subdomains for tracking links (CNAME -> ukv-mailer.onrender.com, added as Render custom domains).
# Falls back to BASE_URL. Keeps *.onrender.com out of the email body.
TRACK_URL_INVESTCHRONICLES=https://go.investchronicles.com
TRACK_URL_MARKETWATCHER=https://go.marketwatcher.co.uk
# Step 1 is sent untracked (no click rewrite, no open pixel) so it reads as a 1:1 email.
TRACK_STEP1=false

# ---- Admin login for the dashboard ----
ADMIN_USER=admin
ADMIN_PASS=change-me

# ---- Sending ----
DAILY_TOTAL=1000             # hard cap on campaign emails per calendar day across all mailboxes
MAILBOX_DAILY_CAP=40         # hard cap per mailbox per day (actual share = DAILY_TOTAL / active mailboxes, max this)
SEND_DAYS=1,2,3,4,5          # 0=Sun..6=Sat (UK local time)
SEND_WINDOW_START=08:00      # UK local time
SEND_WINDOW_END=17:30
TIMEZONE=Europe/London
SENDING_ENABLED=true         # set false to pause everything

# ---- Maildoso SMTP (same for every mailbox) ----
SMTP_HOST=smtp.maildoso.com
SMTP_PORT=587

# ---- Master inbox IMAP (where every mailbox forwards; host shown on Maildoso > Master Inbox) ----
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=mike.leverington@maildoso.email
IMAP_PASS=
IMAP_POLL_MINUTES=5

# ---- HubSpot (same private app token as the Instantly connector, portal 4633795) ----
HUBSPOT_TOKEN=
HUBSPOT_ENABLED=true

# ---- Local dev only (TLS-intercepted machine) ----
# NODE_TLS_REJECT_UNAUTHORIZED=0

# MillionVerifier bulk API key (scripts/verify-emails.mjs). Enrolment defaults to verified-OK contacts only.
MILLIONVERIFIER_KEY=

# Google Workspace pool: service-account JSON key with domain-wide delegation (scope https://mail.google.com/),
# raw or base64. See docs/google-workspace-pool.md.
GOOGLE_SA_JSON=
